package dashboard

import "local/taskmanager/internal/views"

templ WeekTaskList(pi views.PageInfo) { 
  <div class="dashboard-week-of-tasks fill-parent dashboard-default-borders">
    for _, key := range pi.WeekDateOrderedKeys {
      <div>@DayTaskList(pi.WeekOfTasks[key], pi.WeekCategoryOrderedKeys[key], key)</div>
    }
  </div>
}
